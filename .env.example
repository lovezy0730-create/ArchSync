# ArchSync server configuration (copy to .env for local overrides)
# All values are optional; defaults target a single-machine demo at 127.0.0.1.

NODE_ENV=development
# Bind address. 127.0.0.1 = local demo (mock identity allowed).
# 0.0.0.0 / a LAN IP requires AUTH_CODE (the server refuses unauthenticated
# non-loopback bindings).
HOST=127.0.0.1
PORT=4310

# Where the JSON state store lives (snapshots, annotations, jobs)
DATABASE_PATH=./.local/archsync-state.json

# Deployment deployments only: directory to discover .archsync/project.yaml
# projects in (e.g. a mounted volume). Defaults to the repository root.
# WORKSPACE_ROOT=

# GitHub personal access token (classic PAT with repo scope, or fine-grained
# with read access to Issues/Pull requests). Leave empty to run in demo mode:
# collaboration data then comes from clearly-labelled *.demo.json fixtures.
# NEVER commit a real token.
GITHUB_TOKEN=

# Access-code auth for non-loopback deployments: visitors exchange this code
# (login page) for an HttpOnly session cookie (12h). Minimum 8 characters.
# When set, it takes precedence over DEV_AUTH_MODE and allows any HOST.
AUTH_CODE=

# DEV_AUTH_MODE=mock keeps the local demo identity (no access code).
# It is only ever allowed while HOST is a loopback address.
DEV_AUTH_MODE=mock

# Presence heartbeat / session expiry tuning (seconds)
PRESENCE_TTL_SECONDS=45

# Debounce window for local file watching (ms)
WATCH_DEBOUNCE_MS=500
