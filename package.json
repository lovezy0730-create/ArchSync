{
  "name": "archsync",
  "private": true,
  "version": "0.1.0",
  "description": "ArchSync — architecture visualization and team collaboration workbench",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx apps/server/src/index.ts",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @archsync/web build",
    "snapshot:generate": "tsx apps/server/src/pages/generate-static-snapshot.ts",
    "build:pages": "pnpm snapshot:generate && pnpm --filter @archsync/web exec vite build --mode pages",
    "preview:pages": "pnpm --filter @archsync/web exec vite preview --mode pages",
    "verify:pages": "node scripts/verify-pages-dist.mjs",
    "agent": "tsx apps/server/src/agent/cli.ts",
    "archsync:init": "tsx apps/server/src/init/init-wizard.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
